# Настройки по умолчанию для проекта Wi-Fi репитера на ESP32-S3.
# Применяются при первой сборке (когда файла sdkconfig ещё нет).
# После первой сборки правьте параметры через `idf.py menuconfig`.

# ---- Чип ----
CONFIG_IDF_TARGET="esp32s3"

# ---- Обязательная основа репитера: форвардинг и NAT ----
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# ---- DHCP-сервер для клиентов своей сети ----
CONFIG_LWIP_DHCPS=y

# ---- Чуть больше буферов Wi-Fi, чтобы раздача не «захлёбывалась» ----
# (каждый буфер занимает ОЗУ; если памяти мало — уменьшите значения)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BA_WIN=16
CONFIG_ESP_WIFI_RX_BA_WIN=16

# ---- Таблица разделов: приложению отдаём 2 МБ (см. partitions.csv) ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Размер flash микросхемы (у большинства плат S3 — 4, 8 или 16 МБ) ----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# ---- Логи ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- Настройки сетей (можно задавать здесь вместо menuconfig) ----
# Внимание: строки вида CONFIG_X="значение" должны быть раскомментированы
# ДО первой сборки, иначе они не попадут в sdkconfig.
#
# Принимаемая (внешняя) сеть:
# CONFIG_REPEATER_UPSTREAM_SSID="MyWiFi"
# CONFIG_REPEATER_UPSTREAM_PASSWORD="пароль_внешней_сети"
#
# Раздаваемая (своя) сеть:
# CONFIG_REPEATER_AP_SSID="MyWiFi-EXT"
# CONFIG_REPEATER_AP_PASSWORD="пароль_своей_сети"
# CONFIG_REPEATER_AP_IP="192.168.4.1"
