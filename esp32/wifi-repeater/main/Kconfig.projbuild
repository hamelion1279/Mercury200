menu "Wi-Fi repeater (ESP32-S3)"

    comment "Принимаемая (внешняя) сеть — режим станции (STA)"

    config REPEATER_UPSTREAM_SSID
        string "Имя внешней Wi-Fi сети (SSID)"
        default "MyWiFi"
        help
            Сеть, к которой репитер подключается как клиент (её он «принимает»).
            Поддерживаются только сети 2,4 ГГц (ESP32-S3 не умеет 5 ГГц).

            Если задать здесь своё значение, репитер будет подключаться именно
            к этой сети. Пустая строка = подключаться к любой найденной
            (в этом случае пока не будет пароля — см. ниже).

    config REPEATER_UPSTREAM_PASSWORD
        string "Пароль внешней сети"
        default ""
        help
            Пустая строка = сеть без пароля (открытая).
            Для открытой сети не забудьте выбрать порог безопасности OPEN
            в пункте «Минимальный уровень шифрования внешней сети».

    config REPEATER_UPSTREAM_BSSID
        string "BSSID внешней сети, необязательно (AA:BB:CC:DD:EE:FF)"
        default ""
        help
            Если у вас несколько точек доступа с одинаковым SSID (mesh), можно
            жёстко привязаться к конкретной. Пусто = выбирать точку с лучшим
            уровнем сигнала.

    choice REPEATER_UPSTREAM_AUTHMODE_THRESHOLD
        prompt "Минимальный уровень шифрования внешней сети"
        default REPEATER_AUTH_WPA2_PSK
        help
            Точки доступа со «слабым» шифрованием (ниже порога) игнорируются.
            Для WPA2/WPA3-сетей оставьте WPA2/WPA3. Если внешняя сеть открытая,
            выберите OPEN, иначе подключение не состоится.

        config REPEATER_AUTH_OPEN
            bool "Открытая сеть (без пароля)"
        config REPEATER_AUTH_WEP
            bool "WEP (устаревшее)"
        config REPEATER_AUTH_WPA_PSK
            bool "WPA PSK (устаревшее)"
        config REPEATER_AUTH_WPA2_PSK
            bool "WPA2 PSK"
        config REPEATER_AUTH_WPA_WPA2_PSK
            bool "WPA/WPA2 PSK"
        config REPEATER_AUTH_WPA3_PSK
            bool "WPA3 PSK"
        config REPEATER_AUTH_WPA2_WPA3_PSK
            bool "WPA2/WPA3 PSK"
    endchoice

    config REPEATER_RESCAN_PERIOD
        int "Период поиска внешней сети, с"
        range 10 600
        default 30
        help
            Как часто заново сканировать эфир, пока связь с внешней сетью
            отсутствует (канал и точку доступа ищем заново).

    comment "Своя (раздаваемая) сеть — режим точки доступа (SoftAP)"

    config REPEATER_AP_SSID
        string "Имя своей сети (пусто = <имя внешней сети>-EXT)"
        default ""
        help
            Сеть, которую репитер «создаёт». Если оставить пустым, получится
            имя внешней сети с суффиксом EXT, например MyWiFi-EXT.
            Можно задать такое же имя, как у внешней сети, — тогда клиенты
            будут видеть одно имя (как у обычных «усилителей» Wi-Fi).

    config REPEATER_AP_PASSWORD
        string "Пароль своей сети (пусто = открытая сеть)"
        default "repeater-ext"
        help
            Пароль для клиентов своей точки доступа. Минимум 8 символов
            (иначе WPA2 не разрешён — сеть станет открытой).
            Пустая строка = открытая сеть (не рекомендуется).

    config REPEATER_AP_CHANNEL
        int "Канал своей сети (0 = как у внешней сети)"
        range 0 13
        default 0
        help
            У ESP32 одно радио, поэтому своя точка доступа вынужденно работает
            на том же канале, что и принимаемая сеть. Значение 0 — канал
            определяется автоматически при подключении к внешней сети
            (рекомендуется). Явное значение задаётся только для случая,
            когда внешняя сеть ещё не найдена.

    config REPEATER_AP_MAX_STA
        int "Максимальное число клиентов своей сети"
        range 1 10
        default 4
        help
            Сколько устройств могут одновременно подключиться к точке доступа
            репитера. Каждый клиент тратит часть ОЗУ.

    config REPEATER_AP_HIDDEN
        bool "Скрыть SSID своей сети"
        default n

    config REPEATER_AP_IP
        string "IP-адрес репитера в своей сети"
        default "192.168.4.1"
        help
            Этот адрес получают клиенты в качестве шлюза и адреса репитера.
            Если внешняя (принимаемая) сеть использует ту же подсеть,
            например 192.168.4.0/24, измените, например, на 192.168.50.1 —
            иначе клиенты «потеряют» интернет.

    config REPEATER_AP_NETMASK
        string "Маска подсети своей сети"
        default "255.255.255.0"

    config REPEATER_AP_DNS
        string "DNS для клиентов (пусто = DNS внешней сети)"
        default ""
        help
            Пусто = клиентам раздаётся DNS-сервер, полученный от внешней сети
            (обычно роутер). Можно указать вручную, например 1.1.1.1.

    comment "Прочее"

    config REPEATER_HOSTNAME
        string "Имя устройства в сети (DHCP hostname)"
        default "esp32-repeater"
        help
            По этому имени репитер будет виден в списке клиентов роутера.

    config REPEATER_STATUS_LOG_PERIOD
        int "Период вывода статуса в лог, с (0 = выключить)"
        range 0 3600
        default 60

    config REPEATER_STATUS_LED_GPIO
        int "GPIO светодиода статуса (-1 = нет светодиода)"
        range -1 48
        default -1
        help
            Номер вывода, к которому подключён светодиод.
            «-1» — выключено. Например, у ESP32-S3-DevKitC-1 есть
            адресный светодиод на GPIO48, у многих плат — простой на GPIO2.

            Индикация:
              * ровно горит — связь с внешней сетью есть, интернет раздаётся;
              * мигает — внешней сети нет, идёт поиск/подключение.

    config REPEATER_STATUS_LED_ACTIVE_LOW
        bool "Светодиод подключён к питанию (активный низкий уровень)"
        default n
        help
            Включите, если светодиод загорается при нуле на выводе
            (например, катод к GPIO, анод к +3,3 В).
endmenu
